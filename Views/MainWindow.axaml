<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FormaterXJ.ViewModels"
        xmlns:models="using:FormaterXJ.Models"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="FormaterXJ.Views.MainWindow"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        Loaded="MainWindow_Loaded"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="Window_DragOver"
        DragDrop.Drop="Window_Drop"
        Title="">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="36,*">
        <Grid Grid.Row="0"
              Background="Transparent"
              VerticalAlignment="Stretch"
              PointerPressed="TitleBar_PointerPressed"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Menu Padding="8,2"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  chrome:WindowDecorationProperties.ElementRole="User">
                <MenuItem Header="Archivo"
                          SubmenuOpened="FileMenu_SubmenuOpened">
                    <MenuItem Header="Abrir..." Click="OpenMenuItem_Click" />
                    <MenuItem Header="Guardar formateado..." Click="SaveMenuItem_Click" />
                    <MenuItem Header="Perfiles">
                        <MenuItem Header="Crear..." Click="CreateProfileMenuItem_Click" />
                        <MenuItem Header="Editar..." Click="EditProfileMenuItem_Click" />
                        <MenuItem Header="Eliminar..." Click="DeleteProfileMenuItem_Click" />
                        <MenuItem Header="Seleccionar..." Click="SelectProfileMenuItem_Click" />
                    </MenuItem>
                    <MenuItem x:Name="RecentFilesMenu" Header="Archivos recientes">
                        <MenuItem Header="(Sin archivos recientes)"
                                  IsEnabled="False" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Cerrar" Click="CloseMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="Buscar" Click="SearchMenuItem_Click" />
                <MenuItem Header="Opciones">
                    <MenuItem Header="Posición de los paneles">
                        <MenuItem Header="Árbol a la izquierda"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsTreeOnLeft, Mode=TwoWay}" />
                        <MenuItem Header="Árbol a la derecha"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsTreeOnRight, Mode=TwoWay}" />
                    </MenuItem>
                    <MenuItem Header="Estilo del árbol">
                        <MenuItem Header="Estándar"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsStandardTreeStyle}"
                                  Click="StandardTreeStyle_Click" />
                        <MenuItem Header="Compacto"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsCompactTreeStyle}"
                                  Click="CompactTreeStyle_Click" />
                        <MenuItem Header="Tarjetas"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsCardTreeStyle}"
                                  Click="CardTreeStyle_Click" />
                        <MenuItem Header="Explorador JSON"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsExplorerTreeStyle}"
                                  Click="ExplorerTreeStyle_Click" />
                        <MenuItem Header="Explorador XML"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsExplorerXmlStyleSelected}"
                                  Click="ExplorerXmlTreeStyle_Click" />
                    </MenuItem>
                    <MenuItem Header="Tema">
                        <MenuItem Header="Oscuro"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsDarkTheme}"
                                  Click="DarkTheme_Click" />
                        <MenuItem Header="Claro"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsLightTheme}"
                                  Click="LightTheme_Click" />
                        <MenuItem Header="Tema del sistema"
                                  ToggleType="Radio"
                                  IsChecked="{Binding IsSystemTheme}"
                                  Click="SystemTheme_Click" />
                    </MenuItem>
                    <MenuItem Header="Vista">
                        <MenuItem Header="Tamaño de letra del editor">
                            <MenuItem Header="10 pt" Tag="10" Click="EditorFontSize_Click" />
                            <MenuItem Header="12 pt" Tag="12" Click="EditorFontSize_Click" />
                            <MenuItem Header="14 pt" Tag="14" Click="EditorFontSize_Click" />
                            <MenuItem Header="16 pt" Tag="16" Click="EditorFontSize_Click" />
                            <MenuItem Header="18 pt" Tag="18" Click="EditorFontSize_Click" />
                        </MenuItem>
                        <MenuItem Header="Tamaño de letra del árbol">
                            <MenuItem Header="10 pt" Tag="10" Click="TreeFontSize_Click" />
                            <MenuItem Header="12 pt" Tag="12" Click="TreeFontSize_Click" />
                            <MenuItem Header="14 pt" Tag="14" Click="TreeFontSize_Click" />
                            <MenuItem Header="16 pt" Tag="16" Click="TreeFontSize_Click" />
                            <MenuItem Header="18 pt" Tag="18" Click="TreeFontSize_Click" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Numeración de líneas"
                                  ToggleType="CheckBox"
                                  IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}"
                                  Click="LineNumbersMenuItem_Click" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Ayuda">
                    <MenuItem Header="Resumen de los menús"
                              Click="HelpSummaryMenuItem_Click" />
                    <MenuItem Header="Acerca de FormaterXJ"
                              Click="AboutMenuItem_Click" />
                </MenuItem>
            </Menu>
            <TextBlock Text="{Binding DetectedFormat}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto" Margin="16">
            <Grid ColumnDefinitions="*,3,*">
                <Border Grid.Column="{Binding DocumentPanelColumn}"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border IsVisible="{Binding ShowLineNumbers, Mode=OneWay}"
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeForegroundBrush}"
                                BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="LineNumberScrollViewer"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding LineNumbersText}"
                                           FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                           FontSize="{Binding EditorFontSize}"
                                           TextAlignment="Right"
                                           TextWrapping="NoWrap"
                                           Foreground="{DynamicResource ThemeForegroundBrush}"
                                           Opacity="0.65"
                                           Padding="0,4,4,4" />
                            </ScrollViewer>
                        </Border>
                        <TextBox x:Name="DocumentEditor"
                                 Grid.Column="1"
                                 Text="{Binding InputText}"
                                 PlaceholderText="Pega o escribe tu JSON o XML aquí..."
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                 FontSize="{Binding EditorFontSize}"
                                 PastingFromClipboard="DocumentEditor_PastingFromClipboard"
                                 SelectionBrush="#FFB900"
                                 SelectionForegroundBrush="#202020"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 ClearSelectionOnLostFocus="False" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#707070"
                              MinWidth="3" />

                <Border Grid.Column="{Binding TreePanelColumn}"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Margin="0,0,0,8">
                            <Button Content="Expandir todo"
                                    Command="{Binding ExpandAllNodesCommand}"
                                    IsEnabled="{Binding HasValidDocument}"
                                    Padding="12,6" />
                            <Button Content="Contraer todo"
                                    Command="{Binding CollapseAllNodesCommand}"
                                    IsEnabled="{Binding HasValidDocument}"
                                    Padding="12,6" />
                        </StackPanel>
                        <TreeView Grid.Row="1"
                                  x:Name="StructureTree"
                                  x:CompileBindings="False"
                                  ItemsSource="{Binding RootNodes}"
                                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                  FontSize="{Binding TreeFontSize}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Margin"
                                            Value="{Binding DataContext.TreeItemMargin, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                    <Setter Property="MinHeight"
                                            Value="{Binding DataContext.TreeItemMinHeight, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                    <Setter Property="Padding"
                                            Value="{Binding DataContext.TreeItemPadding, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                </Style>
                                <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                                    <Setter Property="Width"
                                            Value="{Binding DataContext.TreeExpanderSize, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                    <Setter Property="Height"
                                            Value="{Binding DataContext.TreeExpanderSize, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                </Style>
                                <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
                                    <Setter Property="Margin"
                                            Value="{Binding DataContext.TreeExpanderMargin, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}" DataType="models:DocumentNode">
                                    <Border Padding="{Binding DataContext.TreeItemPadding, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                            BorderBrush="{DynamicResource ThemeForegroundBrush}"
                                            BorderThickness="{Binding DataContext.TreeHeaderBorderThickness, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                            CornerRadius="{Binding DataContext.TreeHeaderCornerRadius, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                        <Border.ContextMenu>
                                            <ContextMenu Opening="NodeContextMenu_Opening">
                                                <MenuItem Header="Copiar ruta"
                                                          Click="CopyNodePath_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Background>
                                            <Binding Path="SearchBackground" />
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding ExplorerIcon}"
                                                       FontSize="{Binding ExplorerIconFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding ExplorerIconBrush}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding DataContext.IsExplorerTreeStyle, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                            <TextBlock Text="{Binding XmlExplorerIcon}"
                                                       FontSize="{Binding ExplorerIconFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding XmlExplorerIconBrush}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding DataContext.IsExplorerXmlTreeStyle, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                            <TextBlock Text="{Binding ExplorerLabel}"
                                                       Foreground="{Binding ExplorerForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding DataContext.IsExplorerTreeStyle, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        IsVisible="{Binding DataContext.IsExplorerXmlTreeStyle, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                                <TextBlock Text="{Binding XmlExplorerLabel}"
                                                           Foreground="{Binding XmlExplorerForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding XmlExplorerContentLabel}"
                                                           Foreground="{Binding XmlExplorerContentBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding HasXmlExplorerContent}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding DataContext.IsDefaultTreePresentation, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                        </StackPanel>
                                    </Border>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding ProfileStatus}"
                       IsVisible="{Binding HasProfileStatus}"
                       Margin="0,12,0,0" />

            <Border Grid.Row="2"
                    IsVisible="{Binding HasError}"
                    BorderBrush="#c75a5a"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#3b2020"
                    Padding="12"
                    Margin="0,12,0,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#ffd5d5" />
                    <TextBlock IsVisible="{Binding HasErrorLocation}">
                        <Run Text="Línea " />
                        <Run Text="{Binding ErrorLine}" />
                        <Run Text=", columna " />
                        <Run Text="{Binding ErrorColumn}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
